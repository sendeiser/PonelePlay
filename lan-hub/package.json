{
  "name": "poneleplay-lan-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=cjs --external:bufferutil --external:utf-8-validate --outfile=dist/poneleplay-lan.cjs",
    "test": "tsx --test src/hub.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
